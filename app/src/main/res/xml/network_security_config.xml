<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS uniquement, vers le domaine afriboost.com et sous-domaines (ex: reseller.afriboost.com) -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">afriboost.com</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>

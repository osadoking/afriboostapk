<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AfriBoost" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/afriboost_blue</item>
        <item name="colorPrimaryDark">@color/afriboost_blue_dark</item>
        <item name="colorAccent">@color/afriboost_yellow</item>
        <item name="android:statusBarColor">@color/afriboost_blue</item>

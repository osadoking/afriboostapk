<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Pour les notifications push (Android 13+ exige une permission explicite) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Pour permettre à l'utilisateur de prendre une photo depuis le formulaire web
         (ex: preuve de paiement) plutôt que de choisir un fichier existant uniquement -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".AfriBoostApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.AfriBoost"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <activity
            android:name=".SplashActivity"
            android:theme="@style/Theme.AfriBoost.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <!-- Deep link : retour depuis une page de paiement (Ikeepay, Mbiyo, etc.)
                 ex: afriboost://payment-return?status=success -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="afriboost" android:host="payment-return" />
            </intent-filter>
            <!-- Deep link https (App Links) pour les liens afriboost.com/app/... -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.afriboost.com" android:pathPrefix="/app" />
                <data android:scheme="https" android:host="afriboost.com" android:pathPrefix="/app" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.AfriBoostMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/afriboost_blue" />

    </application>

</manifest>
